<?xml version="1.0" encoding="utf-8" ?>
<!-- Event list with search, date filters, refresh, and status feedback. -->
<ContentPage
    x:Class="EventUserApp.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EventUserApp.Models"
    xmlns:views="clr-namespace:EventUserApp.Views"
    Title="Event Assistant"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Application header, refresh control, greeting, and page title. -->
        <VerticalStackLayout Grid.Row="0" Padding="20,12,20,0" Spacing="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Event Manager" Style="{StaticResource AppHeaderTitle}" VerticalOptions="Center" />
                <ImageButton Grid.Column="1"
                             Source="icon_refresh.png"
                             Style="{StaticResource CircleIconButton}"
                             Clicked="OnRefreshClicked"
                             SemanticProperties.Description="Refresh events" />
            </Grid>
            <Label Text="Welcome" Style="{StaticResource Caption}" FontSize="15" Margin="0,22,0,0" />
            <Label Text="Find your next event" Style="{StaticResource PageTitle}" />
        </VerticalStackLayout>

        <!-- Search field for event names and dates. -->
        <Border Grid.Row="1" Style="{StaticResource SearchBox}" Margin="18,18,18,14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="18,0,12,0">
                <Image Source="icon_search.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Entry x:Name="searchBar"
                       Grid.Column="1"
                       Placeholder="Search by name or date"
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="White"
                       ReturnType="Search"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="OnSearchTextChanged"
                       SemanticProperties.Description="Search events by name or date" />
            </Grid>
        </Border>

        <!-- Date filter controls. -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="10" Padding="18,0,18,14">
                <Button x:Name="chipAll" Text="All" Style="{StaticResource ChipSelected}" Clicked="OnChipClicked" />
                <Button x:Name="chipUpcoming" Text="Upcoming" Style="{StaticResource Chip}" Clicked="OnChipClicked" />
                <Button x:Name="chipPast" Text="Past" Style="{StaticResource Chip}" Clicked="OnChipClicked" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Offline or update status message. -->
        <Label x:Name="statusLabel"
               Grid.Row="3"
               Style="{StaticResource StatusBanner}"
               IsVisible="False" />

        <!-- Pull-to-refresh control for reloading cloud data. -->
        <RefreshView x:Name="refreshView"
                     Grid.Row="4"
                     RefreshColor="{StaticResource BrandPrimary}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="eventsList"
                            SelectionMode="Single"
                            SelectionChanged="OnEventSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventItem">
                        <views:EventCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator x:Name="busyIndicator"
                           Grid.Row="4"
                           IsVisible="False"
                           IsRunning="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource BrandPrimary}" />
    </Grid>
</ContentPage>
