<?xml version="1.0" encoding="utf-8" ?>
<!-- Home tab: the events published by the admin app, with search (feature g). -->
<ContentPage
    x:Class="EventUserApp.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EventUserApp.Models"
    xmlns:views="clr-namespace:EventUserApp.Views"
    Title="Events">

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar x:Name="searchBar"
                   Grid.Row="0"
                   Placeholder="Search by name or date (DD/MM/YYYY)"
                   TextChanged="OnSearchTextChanged" />

        <!-- "You are offline..." or "Could not update..." message -->
        <Label x:Name="statusLabel"
               Grid.Row="1"
               Style="{StaticResource StatusBanner}"
               IsVisible="False" />

        <!-- Pull down to reload from the cloud -->
        <RefreshView x:Name="refreshView" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="eventsList"
                            SelectionMode="Single"
                            SelectionChanged="OnEventSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventItem">
                        <views:EventCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator x:Name="busyIndicator"
                           Grid.Row="2"
                           IsVisible="False"
                           IsRunning="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource BrandPrimary}" />
    </Grid>
</ContentPage>
