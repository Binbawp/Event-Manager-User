<?xml version="1.0" encoding="utf-8" ?>
<!-- Second tab: only the events the user marked with the star (feature h). -->
<ContentPage
    x:Class="EventUserApp.Pages.FavouritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EventUserApp.Models"
    xmlns:views="clr-namespace:EventUserApp.Views"
    Title="Favourites">

    <CollectionView x:Name="favouritesList"
                    SelectionMode="Single"
                    SelectionChanged="OnEventSelected"
                    EmptyView="No favourites yet.&#10;Tap the star on an event to add it here.">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:EventItem">
                <views:EventCard />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
