<?xml version="1.0" encoding="UTF-8" ?>
<!-- Styles shared by every screen (Lecture 11). Colours match the Android admin app. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BrandPrimary">#3F51B5</Color>
    <Color x:Key="StarGold">#F5A623</Color>

    <!-- Rounded card used for events, sessions and the details box -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0E0E0, Dark=#444444}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2A2A2A}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
    </Style>

    <Style x:Key="ValueText" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- The favourite star -->
    <Style x:Key="StarButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource StarGold}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Offline / error message strip above the list -->
    <Style x:Key="StatusBanner" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3CD, Dark=#4D3F00}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light=#664D03, Dark=#FFE69C}" />
    </Style>

</ResourceDictionary>
