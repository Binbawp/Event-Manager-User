<?xml version="1.0" encoding="UTF-8" ?>
<!-- Shared styles for the application theme, cards, text, and controls. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colour palette -->
    <Color x:Key="AppBackground">#0B0B0B</Color>
    <Color x:Key="SurfaceColor">#1A1A1A</Color>
    <Color x:Key="SurfaceHighColor">#2A2A2A</Color>
    <Color x:Key="BrandPrimary">#EBFF57</Color>
    <Color x:Key="OnAccent">#0B0B0B</Color>
    <Color x:Key="TextMuted">#A0A0A0</Color>

    <!-- Card styles -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Date badge style. -->
    <Style x:Key="DateBadge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session count badge style. -->
    <Style x:Key="AccentPill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPillText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Session type badge style. -->
    <Style x:Key="TypePill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHighColor}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TypePillText" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Search field style. -->
    <Style x:Key="SearchBox" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="24" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text styles -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Application header text style. -->
    <Style x:Key="AppHeaderTitle" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="ValueText" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Button styles -->
    <!-- Circular icon button style. -->
    <Style x:Key="CircleIconButton" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHighColor}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Circular favourite button style for event cards. -->
    <Style x:Key="CardHeart" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHighColor}" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Transparent favourite button style. -->
    <Style x:Key="HeartButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <!-- Circular favourite button style for the details page. -->
    <Style x:Key="HeartCircle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHighColor}" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <!-- Event filter chip styles. -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="ChipSelected" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Offline and error status banner style. -->
    <Style x:Key="StatusBanner" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BackgroundColor" Value="#2E2A0A" />
        <Setter Property="TextColor" Value="#FFE69C" />
    </Style>

</ResourceDictionary>
