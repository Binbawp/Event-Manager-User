<?xml version="1.0" encoding="UTF-8" ?>
<!-- One event card, used by the Events list and the Favourites list. Its BindingContext is an EventItem. -->
<ContentView
    x:Class="EventUserApp.Views.EventCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EventUserApp.Models"
    x:DataType="models:EventItem">

    <Border Style="{StaticResource CardBorder}" Margin="12,6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,12">

            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                <Label Text="{Binding SubtitleText}" Style="{StaticResource CardSubtitle}" />
                <Label Text="{Binding SessionCountText}"
                       TextColor="{StaticResource BrandPrimary}"
                       FontAttributes="Bold"
                       FontSize="14" />
            </VerticalStackLayout>

            <!-- Favourite star: filled when favourite -->
            <Button Grid.Column="1"
                    Text="{Binding FavouriteIcon}"
                    Style="{StaticResource StarButton}"
                    Clicked="OnStarClicked"
                    SemanticProperties.Description="Favourite"
                    SemanticProperties.Hint="Adds or removes this event from your favourites" />
        </Grid>
    </Border>
</ContentView>
