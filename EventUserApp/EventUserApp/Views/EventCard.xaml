<?xml version="1.0" encoding="UTF-8" ?>
<!-- Reusable event card for event lists and the favourites view. -->
<ContentView
    x:Class="EventUserApp.Views.EventCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EventUserApp.Models"
    x:DataType="models:EventItem">

    <Border Style="{StaticResource CardBorder}" Margin="18,5">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14">

            <!-- Date badge. -->
            <Border Style="{StaticResource DateBadge}"
                    WidthRequest="60"
                    HeightRequest="60"
                    VerticalOptions="Start">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                    <Label Text="{Binding DayText}"
                           TextColor="{StaticResource OnAccent}"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding MonthText}"
                           TextColor="{StaticResource OnAccent}"
                           FontSize="12"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       Style="{StaticResource CardTitle}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding HasLocation}">
                    <Label Text="&#x1F4CD;" FontSize="13" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding Location}"
                           Style="{StaticResource CardSubtitle}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1" />
                </Grid>

                <Label Text="{Binding Organiser}"
                       Style="{StaticResource CardSubtitle}"
                       FontSize="13"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       IsVisible="{Binding HasOrganiser}" />

                <Border Style="{StaticResource AccentPill}" Margin="0,2,0,0">
                    <Label Text="{Binding SessionCountText}" Style="{StaticResource AccentPillText}" />
                </Border>
            </VerticalStackLayout>

            <!-- Favourite button. -->
            <Button Grid.Column="2"
                    Text="{Binding FavouriteIcon}"
                    Style="{StaticResource CardHeart}"
                    Clicked="OnStarClicked"
                    SemanticProperties.Description="Favourite"
                    SemanticProperties.Hint="Adds or removes this event from your favourites" />
        </Grid>
    </Border>
</ContentView>
