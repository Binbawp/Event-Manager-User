<?xml version="1.0" encoding="UTF-8" ?>
<!-- Application navigation with Events and Favourites tabs and a dark, accent-colored shell. -->
<Shell
    x:Class="EventUserApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:EventUserApp.Pages"
    Title="Event Manager"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource AppBackground}"
    Shell.ForegroundColor="{StaticResource BrandPrimary}"
    Shell.TitleColor="White"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="#141414"
    Shell.TabBarForegroundColor="{StaticResource BrandPrimary}"
    Shell.TabBarTitleColor="{StaticResource BrandPrimary}"
    Shell.TabBarUnselectedColor="#8A8A8A">

    <TabBar>
        <!-- Create each tab page through its configured content template. -->
        <ShellContent
            Title="Events"
            Icon="tab_events.png"
            Route="EventsPage"
            ContentTemplate="{DataTemplate pages:EventsPage}" />
        <ShellContent
            Title="Favourites"
            Icon="tab_favourites.png"
            Route="FavouritesPage"
            ContentTemplate="{DataTemplate pages:FavouritesPage}" />
    </TabBar>

</Shell>
